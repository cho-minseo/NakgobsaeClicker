  game: {fileID: 2069753693}
  newsText: {fileID: 1070317049}
  interval: 8
  fadeDuration: 0.5
  generalNews:
  - "\uC18D\uBCF4) \uB099\uC9C0 \uD68C\uC7A5\uB2D8, \uAC2F\uBC8C \uD0C8\uCD9C \uC2DC\uB3C4\u2026
    3\uCD08 \uB9CC\uC5D0 \uCCB4\uD3EC"
  - "\uC18C '\uC74C\uBA54\uC5D0\uBC14', \uC624\uB298\uB3C4 \uBB34\uD45C\uC815\uC73C\uB85C
    \uCD9C\uADFC"
  - "\uC0C8\uC6B0 \uB300\uB9AC, \uD5C8\uB9AC \uD3B4\uAE30 \uB3C4\uC804 \uC2E4\uD328\u2026
    \"\uC6D0\uB798 \uC774\uB7AC\uB2E4\""
  - "\uC804\uBB38\uAC00: \"\uB099\uACF1\uC0C8\uB294 \uB9C8\uC9C0\uB9C9\uC5D0 \uBC25
    \uBCF6\uC744 \uB54C\uAC00 \uC9C4\uC9DC\uB2E4\""
  - "\uB3D9\uB124 \uC8FC\uBBFC\uB4E4, \uB099\uACF1\uC0C8 \uB0C4\uC0C8\uC5D0 \uB2E8\uCCB4\uB85C
    \uBC30\uACE0\uD514 \uD638\uC18C"
  - "\uC624\uB298\uC758 \uC6B4\uC138: \uB0C4\uBE44\uB97C \uC800\uC73C\uBA74 \uC88B\uC740
    \uC77C\uC774 \uC0DD\uAE40. \uAC00\uBCF4\uC790\uACE0!"
  - "\uD0B9\uBC1B\uB294 \uC0AC\uC2E4: \uB099\uACF1\uC0C8\uB97C \uC800\uC744\uC218\uB85D
    \uBC30\uAC00 \uB354 \uACE0\uD30C\uC9C4\uB2E4"
  - "\uC57C\uB974! \uC624\uB298\uB3C4 \uB0C4\uBE44\uB294 \uBCF4\uAE00\uBCF4\uAE00"
